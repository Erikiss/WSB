model txl-tiny
seed 0
X1: gauge permute(L[mid].mlp, randperm)
X2: gauge scale(L[mid].mlp, uniform(0.25, 4))
X3: gauge permute(L[mid].heads, perm([1, 0]))
X4: gauge vo(L[mid].H[0], gl)
X5: gauge vo(L[mid].H[1], orth)
X6: gauge qk(L[mid].H[0], gl)
X7: gauge qk(L[mid].H[1], orth, dims=all)
X8: gauge L[mid] := align(L[mid] -> L[mid-1])
X9: gauge permute(L0.mlp, randperm); scale(L0.mlp, uniform(0.5, 2)); permute(L3.heads, randperm); vo(L1.H0, gl); qk(L2.H1, gl)
X10: reparam permute(L1.mlp, randperm); vo(L1.H0, orth)
X11: gauge rotate(L[mid].mlp, orth)
X12: gauge L[mid] := neg(L[mid])
X13: approx(0.001) delete(L[mid])
X14: approx(0.000001) scale(L[mid].mlp, uniform(0.5, 2))
X15: edit delete(L[mid])
X16: edit swap(L[mid-1], L[mid])
X17: edit L[mid+1] := neg_writers(L[mid-1])
X18: edit L[mid] := lerp(L[mid-1], L[mid+1], 0.5)
X19: edit rotate(L[mid].mlp, orth)
X20: edit L[mid] := neg(L[mid])
X21: edit gridop(rot90, block("transformer.layers.0.dec_attn.qkv_net.weight", 0, 8, 0, 8))
X22: edit gridop(hmirror, block("transformer.word_emb.emb_layers.0.weight", 0, 16, 0, 16))
X23: edit permute(L1.mlp, randperm)
X24: edit L[mid-1] := lerp(L[mid-1], align(L[mid] -> L[mid-1]), 0.5)
